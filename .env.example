# DENSO IoT Monitoring System (KaiLink) - Environment Configuration Template
# Copy this file to .env and replace with your actual environment values

# Server Port & Mode
PORT=5000
NODE_ENV=development

# JWT Authentication Secrets (Generate secure random keys in production)
JWT_SECRET=your-enterprise-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-enterprise-jwt-refresh-secret-change-in-production

# MySQL Database Connection (Use Aiven/PlanetScale/Railway/Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=denso_iot_phase1_test

# Frontend Cloud Endpoints (Optional for Vite build when deployed on Vercel)
# VITE_API_URL=https://your-backend-service.onrender.com
# VITE_WS_URL=wss://your-backend-service.onrender.com/ws

# Telemetry File Ingestion Engine (Optional)
ENABLE_FILE_INGESTION=false
FILE_INGESTION_WATCH_DIR=./data_ingestion_watch
